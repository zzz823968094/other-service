{
  "info": {
    "name": "Docker日志查询服务API",
    "description": "Docker日志查询服务的API接口测试集合",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "认证接口",
      "item": [
        {
          "name": "用户登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "http://localhost:9091/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "9091",
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "用户登出",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:9091/api/auth/logout",
              "protocol": "http",
              "host": ["localhost"],
              "port": "9091",
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Docker容器接口",
      "item": [
        {
          "name": "获取容器列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:9091/api/docker/containers",
              "protocol": "http",
              "host": ["localhost"],
              "port": "9091",
              "path": ["api", "docker", "containers"]
            }
          }
        },
        {
          "name": "查询容器日志",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"containerId\": \"anime-gateway-prod\",\n  \"lines\": 100,\n  \"follow\": false\n}"
            },
            "url": {
              "raw": "http://localhost:9091/api/docker/logs",
              "protocol": "http",
              "host": ["localhost"],
              "port": "9091",
              "path": ["api", "docker", "logs"]
            }
          }
        },
        {
          "name": "验证容器是否存在",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:9091/api/docker/containers/anime-gateway-prod/validate",
              "protocol": "http",
              "host": ["localhost"],
              "port": "9091",
              "path": ["api", "docker", "containers", "anime-gateway-prod", "validate"]
            }
          }
        },
        {
          "name": "获取容器日志文件列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:9091/api/docker/containers/anime-gateway-prod/logs",
              "protocol": "http",
              "host": ["localhost"],
              "port": "9091",
              "path": ["api", "docker", "containers", "anime-gateway-prod", "logs"]
            }
          }
        }
      ]
    }
  ]
}
